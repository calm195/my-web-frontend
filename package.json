{
  "name": "personal-website-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "generate": "pnpm --filter @personal/api-client generate",
    "generate:check": "pnpm --filter @personal/api-client generate:check",
    "lint": "eslint apps packages",
    "format:check": "prettier --check apps packages package.json pnpm-workspace.yaml eslint.config.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm generate:check && pnpm lint && pnpm format:check && pnpm typecheck",
    "test": "pnpm --filter @personal/api-client test && pnpm --filter @personal/admin test",
    "build": "pnpm build:web && pnpm build:admin",
    "build:web": "pnpm --filter @personal/web build",
    "build:admin": "pnpm --filter @personal/admin build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "globals": "16.5.0"
  }
}

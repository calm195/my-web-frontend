{
  "name": "personal-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "dev:doctor": "node scripts/dev/services.mjs doctor",
    "dev:prepare": "node scripts/dev/services.mjs prepare",
    "dev:up": "node scripts/dev/services.mjs up",
    "dev:status": "node scripts/dev/services.mjs status",
    "dev:down": "node scripts/dev/services.mjs down",
    "generate": "pnpm --filter @personal/api-client generate",
    "lint": "eslint apps packages scripts/dev scripts/test tests",
    "format:check": "prettier --check apps packages scripts/dev/*.mjs scripts/test tests package.json pnpm-workspace.yaml eslint.config.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "node scripts/dev/quality.mjs check",
    "test": "pnpm --filter @personal/api-client test && pnpm --filter @personal/admin test && node scripts/dev/quality.mjs go-test && pnpm test:lifecycle",
    "test:lifecycle": "pnpm build:api && node --test scripts/dev/*.test.mjs",
    "test:integration": "node scripts/test/integration.mjs",
    "test:e2e": "node scripts/test/e2e.mjs",
    "build": "node scripts/dev/quality.mjs build",
    "build:web": "pnpm --filter @personal/web build",
    "build:admin": "pnpm --filter @personal/admin build",
    "build:api": "node scripts/dev/quality.mjs build-api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "globals": "16.5.0"
  }
}
